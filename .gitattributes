# 默认统一用 LF，避免 GitHub Desktop 反复提示 LF/CRLF 转换
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.java  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf

# 二进制文件不做转换
*.apk    binary
*.zip    binary
*.bundle binary
*.keystore binary
